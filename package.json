{
  "name": "cs-note",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "node scripts/verify-licenses.mjs && node --experimental-strip-types scripts/verify-tarjan-artifact.mjs && node --experimental-strip-types scripts/verify-lis-artifact.mjs && node --experimental-strip-types --test tests/observation.test.mjs tests/tarjan.test.mjs tests/lis.test.mjs tests/algorithm-visualizer.test.mjs",
    "generate:tarjan": "node --experimental-strip-types scripts/generate-tarjan-artifact.mjs",
    "generate:lis": "node --experimental-strip-types scripts/generate-lis-artifact.mjs",
    "verify:tarjan": "node --experimental-strip-types scripts/verify-tarjan-artifact.mjs",
    "verify:lis": "node --experimental-strip-types scripts/verify-lis-artifact.mjs",
    "verify:licenses": "node scripts/verify-licenses.mjs",
    "patch:excalidraw-tools": "node scripts/patch-excalidraw-tools.mjs",
    "vendor:excalidraw": "node scripts/vendor-excalidraw.mjs"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@excalidraw/excalidraw": "0.18.1",
    "@types/node": "^26.2.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "esbuild": "0.28.1",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  }
}
